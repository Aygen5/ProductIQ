{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5433;Database=productiq_db;Username=postgres;Password=postgres"
  },
  "Importer": {
    "DataDirectory": "data/abo",
    "ListingsBaseUrl": "https://amazon-berkeley-objects.s3.amazonaws.com/listings/metadata/",
    "ImagesBaseUrl": "https://amazon-berkeley-objects.s3.amazonaws.com/images/metadata/",
    "ImageCdnBaseUrl": "https://amazon-berkeley-objects.s3.amazonaws.com/images/small/",
    "ListingsFileName": "listings_0.json.gz",
    "ImagesFileName": "images.csv.gz",
    "TargetDomain": "amazon.com",
    "RequireMainImage": true,
    "PreferredLanguage": "en_US",
    "BatchSize": 1000
  },
  "Embedding": {
    "Provider": "OpenAI",
    "Model": "text-embedding-3-small",
    "Dimension": 1536,
    "BatchSize": 50,
    "MaxRetries": 3,
    "ApiKey": ""
  },
  "DuplicateScoring": {
    "BrandWeight": 0.15,
    "CategoryWeight": 0.15,
    "ModelWeight": 0.20,
    "TextWeight": 0.15,
    "SemanticWeight": 0.25,
    "AttributeWeight": 0.10
  }
}
